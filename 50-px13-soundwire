#!/bin/bash
# systemd-sleep hook (post) for ASUS ProArt PX13: launches the SoundWire
# audio recovery as a detached transient unit and returns immediately.
# Recovery must not run inline here: post hooks block systemd-suspend
# completion while the user session is frozen, causing long black screens.
#
# Install: /usr/lib/systemd/system-sleep/50-px13-soundwire (root:root 0755)
# Recovery: /usr/local/lib/px13-soundwire-recover.sh
case "${1:-}" in post) : ;; *) exit 0 ;; esac
systemd-run --no-block --collect --unit "px13-soundwire-recover-$$" \
  /usr/local/lib/px13-soundwire-recover.sh \
  || echo "$(date '+%F %T') ERROR: systemd-run failed; recovery was not started" \
       >> /var/log/px13-soundwire-resume.log 2>/dev/null
exit 0
