#!/bin/bash
# systemd-sleep hook for ProArt PX13 (HN7306): starts SoundWire audio recovery
# in the background and returns immediately.
#
# Why recovery does not run here: post system-sleep hooks block completion of
# systemd-suspend.service, and the user session (user.slice) remains frozen
# until the hook exits. The old version ran recovery inline, causing about 90
# seconds of black screen after every resume and deadlocking while restarting
# PipeWire in a frozen session.
#
# Install: /usr/lib/systemd/system-sleep/50-px13-soundwire (root:root 0755)
# Recovery worker: /usr/local/lib/px13-soundwire-recover.sh
case "${1:-}" in post) : ;; *) exit 0 ;; esac
systemd-run --no-block --collect --unit "px13-soundwire-recover-$$" \
  /usr/local/lib/px13-soundwire-recover.sh \
  || echo "$(date '+%F %T') ERROR: systemd-run failed; recovery was not started" \
       >> /var/log/px13-soundwire-resume.log 2>/dev/null
exit 0
