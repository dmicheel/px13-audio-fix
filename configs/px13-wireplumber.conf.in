# Managed by px13-audio-fix. WirePlumber 0.5+ software-DSP replacement.

wireplumber.profiles = {
  main = {
    node.software-dsp = required
  }
}

monitor.alsa.rules = [
  {
    matches = [
      { device.name = "alsa_card.pci-0000_c4_00.5-platform-amd_sdw" }
    ]
    actions = {
      update-props = {
        device.routes.default-sink-volume = 1.0
      }
    }
  }
]

node.software-dsp.rules = [
  {
    matches = [
      { node.name = "alsa_output.pci-0000_c4_00.5-platform-amd_sdw.HiFi__Speaker__sink" }
    ]
    actions = {
      create-filter = {
        filter-path = "@FILTER_PATH@"
        hide-parent = true
      }
    }
  }
]
